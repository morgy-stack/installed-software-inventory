<Window x:Class="InstalledSoftwareInventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InstalledSoftwareInventory.ViewModels"
        Title="Installed Software Inventory" Height="560" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="12">

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Filter by name or publisher" />

            <Button Grid.Column="1" Content="Refresh" Width="90" Height="28" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2" Content="Export CSV" Width="90" Height="28" Margin="8,0,0,0"
                    Command="{Binding ExportCommand}" />
        </Grid>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Status}" />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                 Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Results -->
        <DataGrid ItemsSource="{Binding Apps}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="2*" />
                <DataGridTextColumn Header="Installed"
                                    Binding="{Binding InstallDate, StringFormat=yyyy-MM-dd}" Width="*" />
                <DataGridCheckBoxColumn Header="Running" Binding="{Binding IsRunning}" Width="Auto" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
